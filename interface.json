{
    "interface_version": 2,
    "name": "MaaTKFM",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 暂无",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAATKFM! 清日常请确保有1个银币凭证",
    "github": "https://github.com/ye-moo/TKFM",
    "github_release": true,
    "icon": "logo.ico",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端（暂无）",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "工服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "e 服（等待更新）",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "group": [
        {
            "name": "daily",
            "label": "日常任务"
        },
        {
            "name": "standalone",
            "label": "独立任务"
        }
    ],
    "import": [
        "Task/preset/daily.json",
        "Task/Day_AP.json",
        "Task/Recruit.json"
    ]
}